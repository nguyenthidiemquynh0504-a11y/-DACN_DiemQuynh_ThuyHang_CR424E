<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_chat">
    <LinearLayout android:id="@+id/chatControls" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="6dp" android:gravity="center_vertical" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/textNewConversation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingHorizontal="12dp" android:gravity="center" android:background="@drawable/bg_bmi_chat_action" android:drawableStart="@drawable/ic_plus_outline" android:drawablePadding="5dp" android:drawableTint="@color/primary" android:text="@string/bmi_chat_new" android:textColor="@color/text_primary" android:textSize="16sp" android:clickable="true" android:focusable="true" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageButton android:id="@+id/buttonHistory" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Xem lịch sử chat" android:src="@drawable/ic_clock_outline" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/primary" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerMessages" android:layout_width="0dp" android:layout_height="0dp" android:paddingHorizontal="14dp" android:paddingTop="12dp" android:paddingBottom="5dp" android:clipToPadding="false" app:layout_constraintTop_toBottomOf="@id/chatControls" app:layout_constraintBottom_toTopOf="@id/textTypingIndicator" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" tools:listitem="@layout/item_chat_message_bot" />
    <TextView android:id="@+id/textTypingIndicator" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginBottom="5dp" android:text="@string/bmi_chat_typing" android:textColor="@color/text_secondary" android:textSize="13sp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toTopOf="@id/layoutInputBar" />
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/layoutInputBar" android:layout_width="0dp" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:background="@color/surface_canvas" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <ImageButton android:id="@+id/buttonAttach" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:contentDescription="Đính kèm" android:src="@drawable/ic_attach_outline" android:background="@drawable/bg_bmi_chat_input" app:tint="@color/primary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintBottom_toBottomOf="parent" android:visibility="gone" />
        <EditText android:id="@+id/editMessage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="7dp" android:background="@drawable/bg_bmi_chat_input" android:hint="@string/bmi_chat_prompt" android:inputType="textCapSentences|textMultiLine" android:maxLines="4" android:minHeight="48dp" android:paddingHorizontal="15dp" android:paddingVertical="10dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="15sp" app:layout_constraintStart_toEndOf="@id/buttonAttach" app:layout_constraintEnd_toStartOf="@id/buttonSend" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
        <ImageButton android:id="@+id/buttonSend" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:contentDescription="Gửi tin nhắn" android:src="@drawable/ic_send" android:background="@drawable/bg_bmi_circle_selected" app:tint="@color/featured_text" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
