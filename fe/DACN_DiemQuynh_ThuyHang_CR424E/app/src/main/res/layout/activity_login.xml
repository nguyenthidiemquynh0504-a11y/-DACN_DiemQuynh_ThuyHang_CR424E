<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="50dp"
        android:paddingBottom="24dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="46dp" android:layout_height="46dp"
                android:importantForAccessibility="no" android:src="@drawable/ic_brand_pulse" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:fontFamily="sans-serif" android:textStyle="bold"
                android:text="@string/bmi_brand" android:textSize="24sp" android:textColor="@color/text_primary" />
        </LinearLayout>
        <TextView android:id="@+id/textWelcome"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="52dp"
            android:text="@string/login_welcome" android:textColor="@color/text_primary"
            android:fontFamily="sans-serif" android:letterSpacing="-0.028"
            android:textSize="46sp" android:textStyle="bold" />
        <TextView android:id="@+id/textSubtitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="7dp" android:text="@string/login_subtitle"
            android:textColor="@color/text_secondary" android:textSize="17sp"
            android:lineSpacingExtra="3dp" />
        <LinearLayout android:id="@+id/cardForm"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="42dp" android:orientation="vertical">

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" android:labelFor="@id/editTextEmail"
                android:text="@string/login_email_hint" android:textSize="16sp"
                android:textColor="@color/text_primary" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutEmail"
                style="@style/Widget.Bmi.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_email_outline">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:maxLines="1"
                    android:hint="@string/login_email_placeholder"
                    android:textColorHint="@color/text_hint"
                    android:inputType="textEmailAddress"
                    android:autofillHints="email"
                    android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:layout_marginBottom="6dp"
                android:labelFor="@id/editTextPassword" android:text="@string/login_password_hint"
                android:textSize="16sp" android:textColor="@color/text_primary" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutPassword"
                style="@style/Widget.Bmi.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_lock_outline"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:maxLines="1"
                    android:hint="@string/login_password_placeholder"
                    android:textColorHint="@color/text_hint"
                    android:inputType="textPassword"
                    android:autofillHints="password"
                    android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLogin" style="@style/Widget.Bmi.PrimaryButton"
                android:layout_width="match_parent" android:layout_height="60dp"
                android:layout_marginTop="32dp" android:textSize="19sp" android:text="@string/login_button" />
            <TextView android:id="@+id/textViewRegister"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:gravity="center"
                android:layout_gravity="center_horizontal" android:layout_marginTop="4dp"
                android:paddingHorizontal="8dp" android:text="@string/login_register_link"
                android:clickable="true" android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:textColor="@color/text_secondary" android:textSize="16sp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/progressBar" android:layout_width="32dp" android:layout_height="32dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="10dp" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
