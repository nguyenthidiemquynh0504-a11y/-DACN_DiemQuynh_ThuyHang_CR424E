<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="196dp" android:layout_height="wrap_content" android:layout_margin="0dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/surface_panel" app:strokeWidth="1dp" app:strokeColor="@color/outline_soft" android:layout_marginEnd="9dp" android:layout_marginBottom="14dp">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:minHeight="96dp">
        <!-- Achievement Icon -->
        <ImageView android:id="@+id/imageAchievementIcon" android:layout_width="34dp" android:layout_height="34dp" android:contentDescription="@string/achievement_icon" android:scaleType="fitCenter" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" tools:src="@android:drawable/star_big_on" android:background="@drawable/bg_bmi_circle" android:padding="7dp" app:tint="@color/primary" />
        <!-- Locked overlay -->
        <View android:id="@+id/viewLockedOverlay" android:layout_width="34dp" android:layout_height="34dp" android:alpha="0.85" android:background="@drawable/bg_bmi_circle" android:visibility="gone" app:layout_constraintStart_toStartOf="@id/imageAchievementIcon" app:layout_constraintTop_toTopOf="@id/imageAchievementIcon" tools:visibility="visible" />
        <!-- Lock icon -->
        <ImageView android:id="@+id/imageLockIcon" android:layout_width="16dp" android:layout_height="16dp" android:contentDescription="@string/locked" android:src="@drawable/ic_lock_outline" android:visibility="gone" app:layout_constraintBottom_toBottomOf="@id/imageAchievementIcon" app:layout_constraintEnd_toEndOf="@id/imageAchievementIcon" app:layout_constraintStart_toStartOf="@id/imageAchievementIcon" app:layout_constraintTop_toTopOf="@id/imageAchievementIcon" tools:visibility="visible" app:tint="@color/text_secondary" />
        <!-- Achievement Title -->
        <TextView android:id="@+id/textAchievementTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@id/imageAchievementIcon" app:layout_constraintTop_toTopOf="@id/imageAchievementIcon" tools:text="🎉 Bước Đầu Tiên" android:maxLines="2" android:ellipsize="end" />
        <!-- Achievement Description -->
        <TextView android:id="@+id/textAchievementDescription" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="12sp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="@id/textAchievementTitle" app:layout_constraintTop_toBottomOf="@id/textAchievementTitle" tools:text="Log bữa ăn đầu tiên" android:maxLines="2" android:ellipsize="end" />
        <!-- Achieved Date (only for unlocked) -->
        <TextView android:id="@+id/textAchievedDate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/accent" android:textSize="10sp" android:visibility="gone" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="@id/textAchievementTitle" app:layout_constraintTop_toBottomOf="@id/textAchievementDescription" tools:text="Đạt được: 12/12/2025" tools:visibility="visible" android:maxLines="1" android:ellipsize="end" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
