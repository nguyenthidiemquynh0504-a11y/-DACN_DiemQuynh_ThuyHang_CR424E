<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="46dp" android:layout_height="46dp"
                android:importantForAccessibility="no" android:src="@drawable/ic_brand_pulse" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:fontFamily="sans-serif-medium"
                android:text="@string/bmi_brand" android:textSize="24sp" android:textColor="@color/text_primary" />
        </LinearLayout>
        <TextView android:id="@+id/textWelcome"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@string/register_welcome" android:textColor="@color/text_primary"
            android:fontFamily="sans-serif" android:letterSpacing="-0.028"
            android:textSize="40sp" android:textStyle="bold" />
        <TextView android:id="@+id/textSubtitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="7dp" android:text="@string/register_subtitle"
            android:textColor="@color/text_secondary" android:textSize="17sp"
            android:lineSpacingExtra="3dp" />
        <LinearLayout android:id="@+id/cardForm"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutFullName"
                style="@style/Widget.Bmi.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/register_full_name_hint"
                app:startIconDrawable="@drawable/ic_profile">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:maxLines="1"
                    android:inputType="textPersonName|textCapWords"
                    android:autofillHints="name"
                    android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutEmail"
                style="@style/Widget.Bmi.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/register_email_hint"
                app:startIconDrawable="@drawable/ic_email_outline">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:maxLines="1"
                    android:inputType="textEmailAddress"
                    android:autofillHints="email"
                    android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutPassword"
                style="@style/Widget.Bmi.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/register_password_hint"
                app:startIconDrawable="@drawable/ic_lock_outline"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:maxLines="1"
                    android:inputType="textPassword"
                    android:autofillHints="newPassword"
                    android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRegister" style="@style/Widget.Bmi.PrimaryButton"
                android:layout_width="match_parent" android:layout_height="60dp"
                android:layout_marginTop="24dp" android:text="@string/register_button" />
            <TextView android:id="@+id/textViewLogin"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:gravity="center"
                android:layout_gravity="center_horizontal" android:layout_marginTop="4dp"
                android:paddingHorizontal="8dp" android:text="@string/register_login_link"
                android:clickable="true" android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:textColor="@color/primary" android:fontFamily="sans-serif-medium" android:textSize="15sp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/progressBar" android:layout_width="32dp" android:layout_height="32dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="10dp" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
